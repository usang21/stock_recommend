# DB (Vercel Postgres / Neon 등 Postgres 호환 연결 문자열)
DATABASE_URL="postgresql://user:password@localhost:5432/stock_recommend"

# 사이트 접근용 고정 비밀번호 (DESIGN.md §10)
SITE_PASSWORD="change-me"
# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -hex 32 등으로 생성)
SESSION_SECRET="change-me-too"

# 재료(뉴스/공시) 판단 Agent가 사용할 모델 제공자:
# "gemini"(기본, 무료 티어로 로컬/운영 모두 사용 가능, 권장) | "anthropic"(유료) | "ollama"(로컬 전용, 클라우드 배포에서는 접근 불가)
MATERIAL_JUDGE_PROVIDER="gemini"

# provider=gemini일 때 필요한 키. https://aistudio.google.com/apikey 에서 무료 발급.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# provider=anthropic일 때 필요한 Claude API 키
ANTHROPIC_API_KEY=""

# provider=ollama일 때 사용하는 로컬 Ollama 설정 (기본값 그대로 두면 됨)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# "1"로 설정하면 재료 판단 모델의 원문 응답을 서버 콘솔에 그대로 출력한다 (문제 진단용)
MATERIAL_JUDGE_DEBUG="0"

# DART 전자공시시스템 Open API 키 (https://opendart.fss.or.kr)
DART_API_KEY=""

# 이메일 알림 (Resend, https://resend.com)
RESEND_API_KEY=""
ALERT_EMAIL_FROM="Stock Screener <alerts@yourdomain.com>"
ALERT_EMAIL_TO="you@example.com"

# 카카오톡 "나에게 보내기" 알림 (리포트 완료 시). 설정 방법은 README의
# "카카오톡 알림 설정" 절 참고. 전부 비워두면 카카오 알림은 조용히 건너뛴다.
KAKAO_REST_API_KEY=""
# 카카오 로그인의 "클라이언트 시크릿"을 활성화했을 때만 필요 (아니면 빈 값 유지)
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:3000/api/kakao/oauth-callback"
# 수신자별로 /api/kakao/oauth-callback 동의 절차를 거쳐 발급받는 리프레시 토큰.
# 수신자를 늘리려면 kakao.ts의 notifyAllKakaoRecipients에 항목을 추가한다.
KAKAO_REFRESH_TOKEN_ME=""
KAKAO_REFRESH_TOKEN_WIFE=""

# 리포트 완료 이메일/카카오 메시지에 넣을 웹페이지 링크의 베이스 URL
# (실제 배포 도메인으로 설정해야 링크가 열린다. 로컬호스트 값은 카카오 메시지에서
# 클릭이 안 됨.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Vercel Cron이 /api/cron/generate-report 호출 시 검증하는 값
# (Vercel이 자동 주입하는 CRON_SECRET을 그대로 사용해도 됨)
CRON_SECRET="change-me-cron"

# 당일 브리핑을 기록할 Notion (DESIGN.md §14)
# 통합 토큰은 https://www.notion.com/my-integrations 에서 발급하고,
# 대상 데이터베이스의 ... 메뉴 > "연결 추가"로 그 통합을 반드시 연결해야 한다.
# 연결하지 않으면 토큰이 맞아도 404가 난다.
NOTION_TOKEN="ntn_change-me"
NOTION_DATABASE_ID="change-me-32-hex"
