// 데일리 트레이딩 종목 스크리너 — DB 스키마
// 설계 근거: DESIGN.md §3(전략/퍼널), §6(단계별 결과 노출), §9(1개월 보관)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 하루치 리포트 생성 1건 (전략 1~3 전체를 묶는 실행 단위)
model ReportRun {
  id        String   @id @default(cuid())
  runDate   DateTime @db.Date // 이 리포트가 대상으로 하는 거래일
  status    String   @default("running") // running | success | partial | failed
  errorMessage String?
  createdAt DateTime @default(now())

  strategyResults StrategyResult[]

  @@unique([runDate])
  @@index([runDate])
}

// 리포트 실행 내 전략 1건의 결과 (퍼널 전체)
model StrategyResult {
  id          String   @id @default(cuid())
  reportRunId String
  reportRun   ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  strategyKey String // "strategy1" | "strategy2" | "strategy3"
  strategyName String
  paramsSnapshot Json // 실행 당시 사용된 파라미터 스냅샷

  steps FunnelStep[]

  @@index([reportRunId])
}

// 퍼널의 각 단계 (예: 1단계 30종목 -> 2단계 4종목 ...)
model FunnelStep {
  id               String   @id @default(cuid())
  strategyResultId String
  strategyResult   StrategyResult @relation(fields: [strategyResultId], references: [id], onDelete: Cascade)
  stepIndex        Int
  stepName         String
  isFinal          Boolean  @default(false)

  picks StockPick[]

  @@index([strategyResultId])
}

// 각 단계를 통과한 종목
model StockPick {
  id           String   @id @default(cuid())
  funnelStepId String
  funnelStep   FunnelStep @relation(fields: [funnelStepId], references: [id], onDelete: Cascade)

  stockCode    String
  stockName    String
  price        Int?
  changeRate   Float?
  volume       BigInt?
  tradingValue BigInt?

  // 전략1 전용: 재료(뉴스/공시) 판단 결과
  materialVerdict String? // "positive" | "negative" | "none"
  materialSummary String?
  materialSources Json?   // [{ title, url, type: "news" | "disclosure", publishedAt }]

  // 전략3 전용: 최근 N거래일 기관/외국인 수급 현황
  institutionalMeetsThreshold Boolean?
  institutionalBuyDaysCount   Int?
  institutionalWindowDays     Int?
  institutionalMinBuyDays     Int?
  institutionalDays           Json? // [{ date, organNetBuy, foreignerNetBuy }]

  // 전략3 전용: 어떤 기준으로 신고가 조건을 통과했는지
  newHighLabel String? // "20일 신고가" | "60일 신고가" | "52주 신고가" | "역사적 신고가"

  @@index([funnelStepId])
  @@index([stockCode])
}

// 전략별 조정 가능한 숫자 파라미터 (§8)
model StrategyParams {
  id          String   @id @default(cuid())
  strategyKey String   @unique
  paramsJson  Json
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 최종 추천 Agent (DESIGN.md §13)
//
// 아래 테이블들은 기존 리포트 파이프라인과 독립적이다. 리포트 생성과 다른
// 스케줄로 실행되고, 기존 테이블을 참조하지 않으며(종목코드로만 느슨하게 연결),
// 1개월 보관 정책(§9)의 삭제 대상에도 포함되지 않는다.
// ─────────────────────────────────────────────────────────────────────────────

// 최종 추천 1회 실행
model FinalRecommendationRun {
  id           String   @id @default(cuid())
  runDate      DateTime @db.Date
  status       String   @default("running") // running | success | failed | skipped
  errorMessage String?
  // 이 추천이 어느 버전의 판단 기준/학습 기록을 보고 만들어졌는지 (§13 변경 이력 추적)
  criteriaVersion Int?
  lessonVersion   Int?
  createdAt    DateTime @default(now())

  picks RecommendationPick[]

  @@unique([runDate])
  @@index([runDate])
}

// 추천/제외된 종목 1건 = 추천 기록(memory). 피드백 루프의 입력이 되므로 삭제하지 않는다.
model RecommendationPick {
  id    String                 @id @default(cuid())
  runId String
  run   FinalRecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  rank          Int? // 추천 종목만 1~5, 제외 종목은 null
  isRecommended Boolean
  stockCode     String
  stockName     String
  reason        String // 추천 근거 또는 제외 사유
  basePrice     Int // 추천일 종가 — 상승/하락 판정의 기준가
  strategyKeys  Json // 이 종목을 낸 전략 키 목록 ["strategy1", ...]
  recommendedAt DateTime @default(now())

  outcome RecommendationOutcome?

  @@index([runId])
  @@index([stockCode])
}

// 피드백 루프의 결과 판정 (추천일 종가 대비 +3%↑ 상승 / -3%↓ 하락 / 그 사이 보합).
// 추천 후 1~5거래일 동안 매 실행마다 갱신되고, 사유 분석은 상승/하락이 확정된
// 시점에 한 번만 기록한다(같은 종목을 매일 다시 분석해 학습 기록을 오염시키지
// 않기 위함).
model RecommendationOutcome {
  id     String             @id @default(cuid())
  pickId String             @unique
  pick   RecommendationPick @relation(fields: [pickId], references: [id], onDelete: Cascade)

  evaluatedAt  DateTime @default(now())
  tradingDays  Int // 추천 후 경과 거래일 수
  currentPrice Int
  changeRate   Float
  verdict      String // "up" | "down" | "flat"
  analysis     String? // 상승/하락 사유 분석 (보합이면 null)
  analyzedAt   DateTime?

  @@index([verdict])
}

// 추천 로직(판단 기준 + 학습 기록)의 버전 이력 (§13 추천 로직 변경 이력).
// 변경할 때마다 새 행을 추가하고 이전 행은 지우지 않는다 — 로직이 왜 지금
// 모습이 됐는지를 설명하는 유일한 기록이기 때문이다.
model RecommendationLogicVersion {
  id           String   @id @default(cuid())
  kind         String // "criteria"(사람이 정한 판단 기준) | "lesson"(피드백 루프가 쌓은 학습 기록)
  version      Int // kind별로 1부터 증가
  content      String // 해당 시점의 md 본문 전체 스냅샷
  changedBy    String // "file"(저장소 SKILL.md에서 올라옴) | "human"(웹에서 직접 수정) | "agent"(피드백 루프)
  changeReason String
  createdAt    DateTime @default(now())

  @@unique([kind, version])
  @@index([kind, createdAt])
}

// 그날 주식시장이 열렸는지 (DESIGN.md §15).
// 장중(13시)에 한 번 확인해 기록하고, 이후 cron들이 이 값을 보고 실행 여부를 정한다.
// 장 마감 후에는 휴장일과 "오늘 장이 끝남"을 구분할 수 없어, 장중에 확인한 결과를
// 남겨두는 것이 유일한 방법이다.
model MarketDayStatus {
  tradeDate    DateTime @id @db.Date // KST 기준 날짜
  isOpen       Boolean
  marketStatus String // 네이버가 보고한 원래 값 (판정이 틀렸을 때 추적용)
  checkedAt    DateTime @default(now())
}
